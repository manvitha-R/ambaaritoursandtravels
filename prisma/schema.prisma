// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?
  role      Role     @default(USER)
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  leads     Lead[]
  bookings  Booking[]
  
  @@map("users")
}

// Lead model (website inquiries)
model Lead {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String
  destination String?
  travelers   Int?
  travelDate  DateTime?
  message     String?
  status      LeadStatus @default(NEW)
  source      LeadSource @default(WEBSITE)
  assignedTo  String?   @map("assigned_to")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  assignedUser User?     @relation(fields: [assignedTo], references: [id])
  
  @@map("leads")
}

// Package model
model Package {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  shortDesc   String?
  duration    String   // e.g., "3N/4D"
  destination String
  price       Float
  discountPrice Float?
  images      String[] // Array of image URLs
  inclusions  String[] // Array of inclusions
  exclusions  String[] // Array of exclusions
  itinerary   Json?    // JSON array of day-wise itinerary
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean  @default(true)
  isOnSale    Boolean  @default(false)
  totalSeats  Int?
  bookedSeats Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  bookings    Booking[]
  categories  PackageCategory[] @relation("PackageCategories")
  
  @@map("packages")
}

// Booking model
model Booking {
  id            String       @id @default(cuid())
  bookingNumber String       @unique
  userId        String       @map("user_id")
  packageId     String       @map("package_id")
  travelers     Int
  totalAmount   Float
  paidAmount    Float        @default(0)
  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)
  travelDate    DateTime
  bookingDate   DateTime     @default(now())
  specialRequests String?
  customerName  String
  customerEmail String
  customerPhone String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  
  user          User         @relation(fields: [userId], references: [id])
  package       Package      @relation(fields: [packageId], references: [id])
  transactions  Transaction[]
  
  @@map("bookings")
}

// Transaction model
model Transaction {
  id          String          @id @default(cuid())
  bookingId   String          @map("booking_id")
  amount      Float
  paymentMethod String
  transactionId String?       @unique
  status      TransactionStatus @default(PENDING)
  createdAt   DateTime        @default(now())
  
  booking     Booking         @relation(fields: [bookingId], references: [id])
  
  @@map("transactions")
}

// Package Category model
model PackageCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  icon      String?
  createdAt DateTime @default(now())
  
  packages  Package[] @relation("PackageCategories")
  
  @@map("package_categories")
}

// Enums
enum Role {
  ADMIN
  SALES
  USER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

enum LeadSource {
  WEBSITE
  SOCIAL_MEDIA
  REFERRAL
  WALK_IN
  PHONE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}